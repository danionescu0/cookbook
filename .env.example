# Copy this file to .env and fill in real values. .env is never committed.

# --- PostgreSQL ---
POSTGRES_USER=cookbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cookbook
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=cookbook
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://cookbook:change-me@rabbitmq:5672/

# --- Languages (shared by api + worker; see README Design Decisions) ---
# Comma-separated. Adding a language here is a config change, not a migration/code change for
# recipe content — the UI chrome still needs a matching frontend/src/i18n/translations/<lang>.ts.
SUPPORTED_LANGUAGES=ro,en
DEFAULT_LANGUAGE=ro

# --- API backend ---
DATABASE_URL=postgresql+psycopg://cookbook:change-me@db:5432/cookbook
# Used later for the back office auth (not wired yet in this vertical slice)
JWT_SECRET=change-me-too

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Worker / scraping ---
ANTHROPIC_API_KEY=
# Sent as the User-Agent header when fetching pages and robots.txt. Browser-like on purpose
# (not an identifying bot string): politeness is enforced via robots.txt + the rate limit
# below, not by advertising ourselves so sites can allow/block us by name.
SCRAPE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Used only when a domain's robots.txt has no explicit Crawl-delay. Per-domain, in-memory,
# reset on worker restart. Kept low since there's no bot-identifying User-Agent to fall back
# on for rate-limit courtesy. Will move to the admin-configurable `settings` table later.
DEFAULT_RATE_LIMIT_REQUESTS_PER_MINUTE=6
SCRAPE_TIMEOUT_SECONDS=15
MAX_HTML_CHARS=200000
# Shared volume path, must match the `images_data` mount in docker-compose.yml for both
# api and worker
IMAGES_DIR=/data/images
IMAGE_MAX_DIMENSION=1600
IMAGE_MAX_SIZE_KB=500
