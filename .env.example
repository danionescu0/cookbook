# Copy this file to .env and fill in real values. .env is never committed.

# --- PostgreSQL ---
POSTGRES_USER=cookbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cookbook
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=cookbook
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://cookbook:change-me@rabbitmq:5672/

# --- API backend ---
# No cross-referencing between .env keys (docker compose's env_file loader doesn't interpolate
# other keys in the same file) — if you change POSTGRES_PASSWORD above, update the password here
# too, and in RABBITMQ_URL below if you change RABBITMQ_PASSWORD.
DATABASE_URL=postgresql+psycopg://cookbook:change-me@db:5432/cookbook

# --- Back office auth ---
# Use a long random value (32+ bytes) in a real deployment, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-too
JWT_EXPIRES_MINUTES=1440

# --- Frontend ---
# Compiled into the frontend's JS bundle at build time (Vite) — can't be changed at runtime by
# any settings row, only by rebuilding the frontend image. Not exposed in the Settings UI.
# Local dev: http://localhost:8000 (the api container's port, published directly by
# docker-compose.override.yml). Production (docker-compose.prod.yml, Caddy in front): use
# https://<your domain>/api — Caddy strips the /api prefix before forwarding to the api
# container, see Caddyfile.
VITE_API_BASE_URL=http://localhost:8000

# --- Reverse proxy / TLS (production only, docker-compose.prod.yml) ---
# The domain Caddy requests a Let's Encrypt certificate for and serves. DNS A (and AAAA, if the
# VPS has IPv6) records for this domain must already point at the server's IP before starting the
# stack, or certificate issuance will fail. Unused in local dev.
DOMAIN=example.com

# --- Worker / scraping ---
# Bootstrap only, same reasoning as ADMIN_PASSWORD above: read once by migration 0006 to seed
# app_settings.anthropic_api_key, then DB-backed — change it via Backoffice > Settings from then
# on, not here.
ANTHROPIC_API_KEY=
# Sent as the User-Agent header when fetching pages and robots.txt. Browser-like on purpose
# (not an identifying bot string): politeness is enforced via robots.txt + the rate limit
# configured in Backoffice > Settings, not by advertising ourselves so sites can allow/block us
# by name. Stays env-only permanently — not exposed in the Settings UI.
SCRAPE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Shared volume path, must match the `images_data` mount in docker-compose.yml for both api and
# worker. Stays env-only permanently — not exposed in the Settings UI.
IMAGES_DIR=/data/images

# Everything else that used to live here — SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE,
# DEFAULT_RATE_LIMIT_REQUESTS_PER_MINUTE, SCRAPE_TIMEOUT_SECONDS, MAX_HTML_CHARS,
# IMAGE_MAX_DIMENSION, IMAGE_MAX_SIZE_KB — is DB-only now (app_settings table, migration 0006
# seeds sane defaults directly, no env var involved at all). Set/change these from
# Backoffice > Settings after first login. See README Design Decisions
# ("Admin-editable settings").
